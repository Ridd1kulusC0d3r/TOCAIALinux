#!/bin/sh
# Parâmetros do live-build para a TOCAIA OSINT Linux (lidos por `lb config`).
# Debian trixie (13) · Xfce · ISO híbrida (BIOS + UEFI) · leve.
set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures "${TOCAIA_ARCH:-amd64}" \
    --archive-areas "main contrib non-free-firmware" \
    --debian-installer none \
    --binary-images iso-hybrid \
    --iso-application "TOCAIA OSINT Linux" \
    --iso-volume "TOCAIA 1.0 Tropeiro" \
    --iso-publisher "DEIVOSINT; https://github.com/Ridd1kulusC0d3r/TOCAIALinux" \
    --iso-preparer "live-build; TOCAIA" \
    --memtest none \
    --apt-indices false \
    --apt-recommends false \
    --firmware-chroot true \
    --firmware-binary true \
    --bootappend-live "boot=live components quiet splash noeject username=analista hostname=tocaia locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo" \
    "${@}"
