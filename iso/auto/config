#!/bin/sh
# Configuração do live-build para a ISO da TOCAIA (Debian 13 "trixie", Xfce).
set -e
lb config noauto \
  --distribution trixie \
  --archive-areas "main contrib non-free-firmware" \
  --debian-installer none \
  --binary-images iso-hybrid \
  --iso-application "TOCAIA OSINT Linux" \
  --iso-publisher "DEIVOSINT" \
  --iso-volume "TOCAIA_TROPEIRO" \
  --memtest none \
  --bootappend-live "boot=live components quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo username=analista hostname=tocaia" \
  "${@}"
